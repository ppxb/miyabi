{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/exhaustive-deps": "error",
    "react/rules-of-hooks": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["node_modules", "**/routeTree.gen.ts"]
}
